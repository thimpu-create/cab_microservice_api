# Notification Service Configuration

# App Configuration
DEBUG=False
APP_NAME=Notification Service
APP_VERSION=1.0.0

# Firebase Configuration
FIREBASE_KEY_PATH=firebase-key.json
FIREBASE_PROJECT_ID=rideconnectnotifications

# Database Configuration (required for device token storage)
# Option 1: SQLite (development)
DATABASE_URL=sqlite:///./notification.db

# Option 2: PostgreSQL (production - uncomment to use)
# DATABASE_URL=postgresql://user:password@localhost:5432/notification_db

# Redis Configuration (for caching device tokens, subscription states)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_V1_PREFIX=/api/v1

# Notification Settings
NOTIFICATION_RETENTION_DAYS=30
MAX_BULK_NOTIFICATION_SIZE=1000

# CORS Settings
CORS_ORIGINS=["*"]

# Server Configuration
HOST=0.0.0.0
PORT=8006
